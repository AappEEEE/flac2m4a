<Window x:Class="Flac2M4A.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLAC 转 M4A" Height="600" Width="880"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="PickButton" Content="选择 FLAC 文件" Padding="16,8" Click="PickButton_Click"
                    Background="#0067C0" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"/>
            <Button x:Name="OutButton" Content="输出文件夹…" Padding="14,8" Margin="8,0,0,0"
                    Click="OutButton_Click"/>
            <Button x:Name="StartButton" Content="开始转换" Padding="16,8" Margin="8,0,0,0"
                    Click="StartButton_Click" IsEnabled="False"
                    Background="#107C10" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"/>
            <Button x:Name="ClearButton" Content="清空列表" Padding="14,8" Margin="8,0,0,0"
                    Click="ClearButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="OutputDirText" Grid.Row="1" Foreground="#555555" Margin="0,0,0,8"
                   TextWrapping="Wrap"/>

        <DataGrid x:Name="FileList" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" BorderBrush="#DDDDDD" RowHeaderWidth="0"
                  AlternatingRowBackground="#FAFAFA" RowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件" Binding="{Binding File}" Width="230"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="信息" Binding="{Binding Info}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3" Margin="0,8,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
